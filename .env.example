# PostgreSQL owned by FastAPI/Alembic
DATABASE_URL=postgresql+psycopg://intentledger:intentledger@127.0.0.1:5432/intentledger
# Offline verified mode. Setting `postgresql` currently fails closed; it never falls back.
INTENTLEDGER_STORAGE=sqlite
INTENTLEDGER_DB_PATH=.intentledger/intentledger.db
# Colon-separated canonical roots from which the CLI may register repositories
ALLOWED_REPOSITORY_ROOTS=/workspace
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
LOCAL_API_TOKEN=replace-with-generated-local-token
API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000
PROVIDER=fixture
MODEL=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
TRACE_SOURCE_CONTENT=false
MAX_BLOB_BYTES=1048576
MAX_HISTORY_COMMITS=500
WORKER_TIMEOUT_SECONDS=60
